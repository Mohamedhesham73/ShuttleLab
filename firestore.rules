rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Coach = role custom claim OR a known coach email (single-coach setup).
    function isCoach() {
      return request.auth != null && (
        request.auth.token.role == 'coach' ||
        request.auth.token.email == 'coach@shuttlelab.app'
      );
    }

    // The team roster. Any signed-in user may READ it (names for dashboards /
    // leaderboard). Only the coach may change it. No emails are stored here.
    match /members/{id} {
      allow read:  if signedIn();
      allow write: if isCoach();
    }

    // Team-readable so the leaderboard / dashboards work.
    match /measurements/{id} { allow read, write: if signedIn(); }
    match /goals/{id}        { allow read, write: if signedIn(); }
    match /drills/{id}       { allow read, write: if signedIn(); }
    match /training/{id}     { allow read, write: if signedIn(); }

    // Plans: each player's plan is team-read / signed-in-write, BUT the two
    // shared docs — the tournament schedule and the coach's gift jar — may only
    // be written by the coach, so a player can't overwrite them.
    match /plans/{id} {
      allow read:  if signedIn();
      allow write: if isCoach() || (signedIn() && id != '__schedule' && id != '__giftjar');
    }

    // Private per-user store (Mind Room mood "stars"). Keyed by the user's own
    // Firebase UID — ONLY that user can ever read or write it. Truly private.
    match /private/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Player → coach messages from the Mind Room. The sender writes their own
    // (stamped with their UID); only that sender or the coach can read them.
    match /messages/{id} {
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      allow read:   if isCoach() || (signedIn() && resource.data.fromUid == request.auth.uid);
      allow update, delete: if isCoach();
    }

    // Videos. Any signed-in member may CREATE (coach adds film; players upload
    // their own clips). Only the coach edits content; a player may delete a clip
    // they uploaded. Players may otherwise update ONLY the watchedBy map.
    match /videos/{id} {
      allow read:   if signedIn();
      allow create: if signedIn();
      allow delete: if isCoach()
        || (signedIn() && resource.data.submittedUid == request.auth.uid);
      allow update: if isCoach()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['watchedBy']);
    }
  }
}
